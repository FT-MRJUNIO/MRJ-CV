@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>Home</PageTitle>

<div class="scroll-container">

    <section id="home" class="scroll-section" data-bg="#a0a0a0">
        <div class="section-content dark-text">
            <h1>Hello World!</h1>
            <p>From my first 'Hello World' to architecting enterprise-grade ecosystems—I’ve been building scalable, secure, and performant software since 2019.</p>
            <a href="knowmore" class="btn btn-link text-dark text-decoration-underline fw-medium">
                Know More <code>&lt;/&gt;</code>...
            </a>
        </div>
    </section>
    <section id="experience" class="scroll-section" data-bg="#00006c">
        <div class="section-content light-text">
            <h1>Dynamic Experience</h1>
            <p>Architecting secure database schemas, high-velocity APIs, and robust cross-platform applications.</p>
            <a href="experience" class="btn btn-link text-white text-decoration-underline">
                View Tech Stack & Systems
            </a>
        </div>
    </section>

    <section id="performance" class="scroll-section" data-bg="#006700">
        <div class="section-content light-text">
            <h1>Performance First</h1>
            <p>Optimizing resource efficiency, scaling deployment environments, and building to deliver value.</p>
            <a href="performance" class="btn btn-link text-white text-decoration-underline fw-bold">
                Hire Me to Know More
            </a>
        </div>
    </section>

</div>

@code {
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/scrollTracker.js");
            await _module.InvokeVoidAsync("initScrollObserver");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroyScrollObserver");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}