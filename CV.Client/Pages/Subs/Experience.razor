@page "/experience"
<PageTitle>Projects & Skills</PageTitle>

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold text-white mb-2">Projects & Exposure</h1>
            <p class="text-white-50 lead">A breakdown of systems managed, framework matrices, and specialized architectures.</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        @foreach (var category in StackCategories)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 bg-dark border border-secondary border-opacity-50 p-4 shadow-sm">
                    <div class="d-flex align-items-center mb-3">
                        <span class="bi @category.Icon text-info fs-3 me-3"></span>
                        <h3 class="h5 fw-bold mb-0 text-white">@category.Title</h3>
                    </div>
                    <p class="text-white-50 small mb-0">@category.Description</p>
                </div>
            </div>
        }
    </div>

    <div class="row g-4">
        <h2 class="h4 fw-bold text-white mb-3">
            <span class="bi bi-person-badge me-2 text-info"></span> Professional History
        </h2>
        @foreach (var env in SystemEnvironments)
        {
            <div class="col-12 col-md-6 col-lg-6">
                <div class="card bg-dark border border-secondary border-opacity-50 p-4 shadow-sm h-100">
                    <h4 class="text-white fw-bold mb-2">@env.Role</h4>
                    <hr class="border-secondary my-2">
                    <div class="mb-2">
                        <small class="text-info fw-bold text-uppercase">Tech Stack:</small>
                        <p class="text-white-50 mb-2 small">@env.Tech</p>
                    </div>
                    <div>
                        <small class="text-info fw-bold text-uppercase">Tools/Env:</small>
                        <p class="text-white-50 mb-0 small">@env.Tools</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private record StackCategory(string Icon, string Title, string Description);
    private record SystemEnv(string Role, string Tech, string Tools);

    private List<StackCategory> StackCategories = new()
    {
        new("bi-code-square", "Languages & Core", "C#.NET / Core, ASP, MVC, Razor Pages, JavaScript, JQuery, VB.Net, ASP Classic."),
        new("bi-database-fill", "Database & Tools", "SQL Server (SSMS 2018-2020), MySQL Workbench 8, Stored Procedures, NoSQL."),
        new("bi-cloud-arrow-up-fill", "APIs & Deployments", "Web API, RESTful, MudBlazor, Blazor WebAssembly, Node.js, React, IIS, Swagger.")
    };

    private List<SystemEnv> SystemEnvironments = new()
    {
        new("Senior Programmer (NSJBI)", ".NET Core / C# / ASP.Net Razor Pages, REST Web API, MudBlazor", "Postman, Swagger, SSMS 2020, IIS"),
        new("Mid Programmer (SLI Co.)", ".NET Core / C# / ASP.Net Razor Pages, REST Web API, Node.js, React", "Postman, Swagger, SSMS 2020, IIS"),
        new("Software Engineer (Rising Tide)", ".NET Core / C# / ASP.Net, REST Web API, Node.js, React", "Postman, Swagger, SSMS 2020, IIS"),
        new("Analyst Programmer (InSiteMy)", "ASP.NET, ASP Classic, MVC, C#, JavaScript, JQuery, VB.Net", "SSMS 2018, IIS")
    };
}